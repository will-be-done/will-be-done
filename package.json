{
  "name": "will-be-done",
  "version": "0.1.0",
  "author": "quolpr",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {},
  "scripts": {
    "dev:client": "pnpm -C apps/web dev",
    "dev:server": "pnpm -C apps/api dev",
    "dev:tursod": "TURSOD_DB_PATH=apps/tursod/db cargo run --manifest-path apps/tursod/Cargo.toml",
    "ts": "pnpm --filter @will-be-done/web ts && pnpm --filter @will-be-done/slices ts && pnpm --filter @will-be-done/api ts",
    "lint": "pnpm --filter @will-be-done/web lint && pnpm --filter @will-be-done/slices lint && pnpm --filter @will-be-done/api lint",
    "test": "pnpm --filter @will-be-done/api test",
    "test:e2e": "pnpm --filter @will-be-done/api test:e2e && pnpm --filter @will-be-done/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "all": "tsx scripts/dev-all.ts",
    "release:desktop": "bash scripts/release",
    "deploy:staging:tursod": "fly deploy --config fly.tursod.staging.toml --app wbd-tursod-staging",
    "deploy:staging:app": "fly deploy --config fly.app.staging.toml --app wbd-app-staging"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "blessed": "^0.1.81",
    "prettier": "^3.8.4",
    "tsx": "^4.21.0"
  }
}
