# Stage 1: Build the Astro site
FROM node:24-alpine AS builder

WORKDIR /app/apps/landing

# Copy only the landing app (no monorepo workspace deps needed)
COPY apps/landing/package.json ./

# Install dependencies
RUN corepack enable && pnpm install

# Copy the rest of the source
COPY apps/landing/ ./

ENV PUBLIC_POSTHOG_KEY=phc_qrPoGFFkFW2yTiRH8Fjt4mHBIm4ZzZK2kSJoI5AqvPu
ENV PUBLIC_POSTHOG_HOST=https://a.will-be-done.app
ENV PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# Build the Astro site
RUN pnpm build

# Stage 2: Serve with nginx
FROM nginx:alpine AS runner

# Copy built static files
COPY --from=builder /app/apps/landing/dist/ /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
