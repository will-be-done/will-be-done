{
  "name": "@will-be-done/api",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "WBD_DB_PATH=../../db bun run src/start.ts",
    "ts": "tsgo -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "client:generate": "orval --config ./orval.config.ts --clean --formatter prettier --fail-on-warnings",
    "openapi:check": "bun run src/generateOpenApi.ts --check",
    "openapi:generate": "bun run src/generateOpenApi.ts",
    "test": "WBD_DB_ENGINE=sqlite bun test --path-ignore-patterns 'src/e2e/**'",
    "test:e2e": "bun test --preload ./src/e2e/setup.ts ./src/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260304.1",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "orval": "^8.23.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.703.0",
    "@doist/todoist-api-typescript": "^6.10.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/websocket": "^11.2.0",
    "@scalar/fastify-api-reference": "^1.63.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "@tursodatabase/api": "^2.0.5",
    "@tursodatabase/serverless": "^1.4.0",
    "@will-be-done/hyperdb": "^0.4.4",
    "@will-be-done/slices": "workspace:*",
    "await-lock": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^7.0.0",
    "fractional-indexing-jittered": "^1.0.0",
    "ioredis": "^6.0.0",
    "uuidv7": "^1.1.0",
    "ws": "^8.19.0",
    "zod": "^4.1.13"
  }
}
