# Cloudflare Turnstile CAPTCHA
WBD_CF_CAPTCHA_ENABLED=false
WBD_CF_CAPTCHA_SITE_KEY=your-site-key
WBD_CF_CAPTCHA_SECRET_KEY=your-secret-key

# Database engine (SQLite remains the default)
WBD_DB_ENGINE=sqlite

# Required when WBD_DB_ENGINE=turso. Use an organization-scoped Platform API
# token and inject it through your deployment's secret manager. The API creates
# all databases and mints short-lived, database-scoped credentials at runtime.
WBD_TURSO_ORG=your-org-or-account-slug
WBD_TURSO_PLATFORM_TOKEN=your-platform-api-token
WBD_TURSO_GROUP=default
WBD_TURSO_DATABASE_PREFIX=wbd

# Cross-process sync notifications. Memory is the zero-dependency default for
# a single server process. Redis is recommended when multiple API instances
# serve WebSocket clients.
WBD_SYNC_NOTIFICATIONS_BACKEND=memory
WBD_REDIS_URL=redis://localhost:6379
WBD_SYNC_NOTIFICATIONS_CHANNEL_PREFIX=wbd:sync:v1

# Optional stable identity for clustered self-hosted processes. Fly.io uses
# FLY_MACHINE_ID automatically; single-process installs can leave this unset.
# WBD_INSTANCE_ID=server-1

# S3 Backup Configuration
WBD_BACKUP_S3_ENABLED=false
WBD_BACKUP_S3_ACCESS_KEY_ID=your-access-key
WBD_BACKUP_S3_SECRET_ACCESS_KEY=your-secret-key
WBD_BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
WBD_BACKUP_S3_BUCKET_NAME=will-be-done-backups
WBD_BACKUP_S3_REGION=us-east-1

# Backup tiers to enable (comma-separated: hourly,daily,weekly,monthly)
# To disable hourly backups, use: daily,weekly,monthly
WBD_BACKUP_ENABLED_TIERS=hourly,daily,weekly,monthly

# Optional: Override retention policy defaults
WBD_BACKUP_HOURLY_INTERVAL_HOURS=4
WBD_BACKUP_HOURLY_KEEP_COUNT=4
WBD_BACKUP_DAILY_KEEP_DAYS=5
WBD_BACKUP_WEEKLY_KEEP_WEEKS=2
WBD_BACKUP_MONTHLY_KEEP_MONTHS=2
