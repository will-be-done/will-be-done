---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { DOWNLOAD_FORMATS, type DesktopDownloads, type Platform } from '../lib/downloads';
import { formatDate, getReleases, isoDate, releasePath } from '../lib/releases';
import downloadsJson from '../data/desktop-downloads.json';

// Regenerated by `pnpm sync:downloads` whenever a release is published.
const downloads: DesktopDownloads = downloadsJson;
const publishedAt = new Date(downloads.publishedAt);

// The landing page for a release arrives in a reviewed pull request, so it can
// lag behind the downloads. Until it is merged, link to GitHub instead.
const hasReleasePage = (await getReleases()).some((release) => release.data.tag === downloads.tag);
const releaseNotesUrl = hasReleasePage ? releasePath(downloads.tag) : downloads.releaseUrl;

const platforms: { id: Platform; name: string }[] = [
  { id: 'mac', name: 'macOS' },
  { id: 'windows', name: 'Windows' },
  { id: 'linux', name: 'Linux' },
];

const formatsFor = (platform: Platform) =>
  DOWNLOAD_FORMATS.filter((format) => format.platform === platform).map((format) => ({
    ...format,
    file: downloads.files[format.id],
  }));

const formatSize = (bytes: number) => `${Math.round(bytes / 1024 / 1024)} MB`;

const siteUrl = 'https://will-be-done.app';
const pagePath = '/download/';
const title = `Download Will Be Done ${downloads.version} for macOS, Windows and Linux`;
const description = `Download the Will Be Done desktop app ${downloads.version} for macOS, Windows and Linux. A local-first task manager with a system tray and a global quick add shortcut.`;

const schema = [
  {
    '@type': 'BreadcrumbList',
    '@id': `${siteUrl}${pagePath}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Download', item: `${siteUrl}${pagePath}` },
    ],
  },
];
---

<Layout title={title} description={description} path={pagePath} ogTitle="Download Will Be Done" schema={schema}>
  <PageBackdrop>
    <main>
      <TopBar active="download" />

      <!-- Header -->
      <section aria-label="Download" class="relative px-6 pb-12 pt-28 md:pt-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-6 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full bg-white/[0.03] px-3.5 py-1.5 text-[10px] font-medium uppercase tracking-[0.1em] text-blue-300/90 ring-1 ring-blue-400/[0.18] sm:px-4 sm:text-[11px] sm:tracking-[0.14em]">
            <span>Desktop app</span>
            <span class="text-blue-400/40">·</span>
            <span>{downloads.tag}</span>
            <span class="text-blue-400/40">·</span>
            <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
          </p>

          <h1 class="mb-5 text-4xl font-bold tracking-tight text-white md:text-5xl">Download Will Be Done</h1>

          <p class="mx-auto mb-9 max-w-2xl text-[17px] leading-relaxed text-slate-400">
            The desktop app adds a system tray and a global quick add shortcut. It works offline and syncs with the
            cloud or your own server.
          </p>

          <!-- Filled in by the script below once the visitor's system is known. -->
          <div class="flex flex-col items-center gap-3">
            {platforms.map((platform) => {
              const formats = formatsFor(platform.id);
              // A single package is an obvious pick. With several (Linux), the
              // right one depends on the distribution, so point at the list.
              if (formats.length > 1) {
                return (
                  <p hidden data-hero-platform={platform.id} class="text-[15px] text-slate-400">
                    Pick the {platform.name} package for your distribution below.
                  </p>
                );
              }
              const [recommended] = formats;
              return (
                <a
                  href={recommended.file.url}
                  hidden
                  data-hero-platform={platform.id}
                  class="inline-flex items-center gap-2.5 rounded-xl bg-blue-500 px-6 py-3.5 text-[15px] font-semibold text-white shadow-[0_2px_12px_rgba(59,130,246,0.3),inset_0_1px_0_rgba(255,255,255,0.15)] transition-all hover:bg-blue-400 hover:shadow-[0_4px_20px_rgba(59,130,246,0.45),inset_0_1px_0_rgba(255,255,255,0.15)]"
                  data-ph-event="desktop_download_clicked"
                  data-ph-section="download_hero"
                  data-ph-destination={recommended.id}
                  data-ph-release-tag={downloads.tag}
                >
                  <PlatformIcon platform={platform.id} class="h-4 w-4" />
                  Download for {platform.name}
                  <span class="font-normal text-blue-100/70">· {formatSize(recommended.file.size)}</span>
                </a>
              );
            })}

            <p data-download-mobile hidden class="max-w-md text-[15px] leading-relaxed text-slate-400">
              The desktop app runs on macOS, Windows and Linux. On a phone or tablet,
              <a href="/docs/install/#install-the-web-app" class="text-blue-300 underline decoration-blue-400/30 underline-offset-4 transition-colors hover:text-blue-200">install the web app</a>
              instead.
            </p>

            <p data-download-fallback class="text-[15px] text-slate-400">Choose your platform below.</p>

            <p class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-[13px] text-slate-500">
              <a
                href={releaseNotesUrl}
                class="text-slate-400 transition-colors hover:text-white"
                data-ph-event="release_opened"
                data-ph-section="download_hero"
                data-ph-release-tag={downloads.tag}
              >
                What's new in {downloads.tag}
              </a>
              <span class="text-slate-700">·</span>
              <a
                href="https://github.com/will-be-done/will-be-done/releases"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-400 transition-colors hover:text-white"
                data-ph-event="github_releases_clicked"
                data-ph-section="download_hero"
              >
                Older versions on GitHub
              </a>
            </p>
          </div>
        </div>
      </section>

      <!-- Every platform -->
      <section aria-label="All downloads" class="relative px-6 pb-16">
        <div class="mx-auto grid max-w-5xl gap-4 md:grid-cols-3 md:items-start">
          {platforms.map((platform) => (
            <div
              id={platform.id}
              data-platform-card={platform.id}
              class="group rounded-2xl bg-white/[0.02] p-5 ring-1 ring-white/[0.06] transition-all data-[detected]:bg-gradient-to-br data-[detected]:from-blue-500/10 data-[detected]:via-transparent data-[detected]:to-indigo-500/10 data-[detected]:ring-blue-400/30"
            >
              <div class="mb-4 flex items-center gap-2.5">
                <PlatformIcon platform={platform.id} class="h-5 w-5 text-slate-300" />
                <h2 class="text-[16px] font-semibold text-white">{platform.name}</h2>
                <span class="ml-auto hidden rounded-full bg-blue-500/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.1em] text-blue-300 ring-1 ring-blue-400/25 group-data-[detected]:inline-flex">
                  Your system
                </span>
              </div>

              <ul class="space-y-2">
                {formatsFor(platform.id).map((format) => (
                  <li>
                    <a
                      href={format.file.url}
                      class="group/link flex items-center gap-3 rounded-xl bg-white/[0.02] px-3.5 py-3 ring-1 ring-white/[0.05] transition-all hover:bg-white/[0.05] hover:ring-white/[0.12]"
                      data-ph-event="desktop_download_clicked"
                      data-ph-section="download_platforms"
                      data-ph-destination={format.id}
                      data-ph-release-tag={downloads.tag}
                    >
                      <span class="min-w-0 flex-1">
                        <span class="block text-[14px] font-medium text-slate-200 group-hover/link:text-white">{format.label}</span>
                        <span class="block text-[12px] text-slate-500">{format.hint} · {formatSize(format.file.size)}</span>
                      </span>
                      <svg class="h-4 w-4 shrink-0 text-slate-500 transition-transform duration-300 group-hover/link:translate-y-0.5 group-hover/link:text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- After installing -->
      <section aria-label="After installing" class="relative border-t border-white/[0.04] px-6 py-16">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="mb-4 text-2xl font-bold tracking-tight text-white">After installing</h2>
          <p class="mb-8 text-[15px] leading-relaxed text-slate-400">
            Open the app, set the server to <code class="rounded bg-white/[0.05] px-1.5 py-0.5 text-[13px] text-slate-300">https://app.will-be-done.app</code>
            or your self-hosted server, and sign in.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <a
              href="/docs/install/"
              class="inline-flex items-center gap-2 rounded-xl bg-white/[0.05] px-6 py-3.5 text-[15px] font-medium text-slate-200 ring-1 ring-white/[0.10] transition-all hover:bg-white/[0.08] hover:text-white hover:ring-white/[0.18]"
              data-ph-event="docs_link_clicked"
              data-ph-section="download_after_install"
            >
              Installation guide
            </a>
            <a
              href="https://demo.will-be-done.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-white/[0.05] px-6 py-3.5 text-[15px] font-medium text-slate-200 ring-1 ring-white/[0.10] transition-all hover:bg-white/[0.08] hover:text-white hover:ring-white/[0.18]"
              data-ph-event="demo_clicked"
              data-ph-section="download_after_install"
            >
              Try it in the browser first
            </a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </PageBackdrop>
</Layout>

<script>
  import type { Platform } from '../lib/downloads';

  // Chromium exposes the OS directly; other browsers only have the user agent.
  type NavigatorWithUAData = Navigator & { userAgentData?: { platform: string } };

  function detectPlatform(): Platform | 'mobile' | undefined {
    const nav = navigator as NavigatorWithUAData;
    const ua = nav.userAgent;
    if (/android|iphone|ipad|ipod/i.test(ua)) return 'mobile';

    const hint = `${nav.userAgentData?.platform ?? nav.platform ?? ''} ${ua}`;
    // iPadOS asks for desktop sites as a Mac; only the touch screen gives it away.
    if (/mac/i.test(hint)) return nav.maxTouchPoints > 1 ? 'mobile' : 'mac';
    if (/win/i.test(hint)) return 'windows';
    if (/linux|x11/i.test(hint)) return 'linux';
    return undefined;
  }

  const detected = detectPlatform();

  if (detected === 'mobile') {
    document.querySelector('[data-download-fallback]')?.setAttribute('hidden', '');
    document.querySelector('[data-download-mobile]')?.removeAttribute('hidden');
  } else if (detected) {
    document.querySelector('[data-download-fallback]')?.setAttribute('hidden', '');
    document.querySelector(`[data-hero-platform="${detected}"]`)?.removeAttribute('hidden');
    document.querySelector(`[data-platform-card="${detected}"]`)?.setAttribute('data-detected', '');
  }
</script>
