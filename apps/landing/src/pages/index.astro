      <!-- WHY: the week is the unit of planning -->
      <section aria-label="Why weekly planning" class="relative px-6 pt-20 pb-12">
        <div class="mx-auto max-w-5xl">
          <div class="mx-auto max-w-3xl text-center">
            <p class="mb-4 text-[12px] font-medium uppercase tracking-[0.16em] text-blue-300/70">Why weekly planning</p>
            <h2 class="mb-5 text-3xl font-bold tracking-tight text-white md:text-5xl leading-[1.1]">
              Your week is the unit of planning
            </h2>
            <p class="mb-4 text-[17px] leading-relaxed text-slate-400">
              Most task managers revolve around Today. Miss a day and the unfinished work piles up into tomorrow, until
              your list is a monument to everything you didn't do.
            </p>
            <p class="text-[17px] leading-relaxed text-slate-400">
              Will Be Done keeps the whole week visible. Every day is a column, so you can see what is realistic, drag
              work between days as plans change, and keep missed tasks in context instead of turning them into an
              overdue pile.
            </p>
          </div>

          <div class="mt-12">
            <Image
              src={weekImg}
              alt="Screenshot showing weekly timeline with day columns for planning your week at a glance"
              class="w-full rounded-2xl ring-1 ring-white/[0.08] shadow-2xl shadow-black/40"
              loading="eager"
            />
          </div>

