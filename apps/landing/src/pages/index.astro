 418 569.1C403.8 570.2 391.5 564.3 384.3 549.8C379.6 538.7 381.9 526.7 385.4 513.5C389.1 499.3 394.6 484.7 395.3 472.9C396.1 457.7 397 444.4 399.5 434.2C402.1 423.9 406.1 417 413.2 413.1C413.5 412.9 413.9 412.8 414.2 412.6C415 425.8 421.5 439.2 433 442.1C445.6 445.4 463.7 434.6 471.4 425.8C480.4 425.5 487.1 424.9 494 430.9C503.9 439.4 501.1 461.2 511.1 472.5C521.7 484.1 525.1 492 524.8 497.1zM269.4 212.7C271.4 214.6 274.1 217.2 277.4 219.8C284 225 293.2 230.4 304.7 230.4C316.3 230.4 327.2 224.5 336.5 219.6C341.4 217 347.4 212.6 351.3 209.2C355.2 205.8 357.2 202.9 354.4 202.6C351.6 202.3 351.8 205.2 348.4 207.7C344 210.9 338.7 215.1 334.5 217.5C327.1 221.7 315 227.7 304.6 227.7C294.2 227.7 285.9 222.9 279.7 218C276.6 215.5 274 213 272 211.1C270.5 209.7 270.1 206.5 267.7 206.2C266.3 206.1 265.9 209.9 269.4 212.7z"/>
              </svg>
              Linux
            </span>
            <span class="text-slate-700">·</span>
            <!-- Windows -->
            <span class="flex items-center gap-1">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 640 640">
                <path d="M96 157.7L279.6 132.4L279.6 309.8L96 309.8L96 157.7zM96 482.3L279.6 507.6L279.6 332.4L96 332.4L96 482.3zM299.8 510.3L544 544L544 332.4L299.8 332.4L299.8 510.3zM299.8 129.7L299.8 309.8L544 309.8L544 96L299.8 129.7z"/>
              </svg>
              Windows
            </span>
          </p>
        </div>
      </section>

      <!-- App UI right under the hero -->
      <section aria-label="App screenshots" class="relative overflow-hidden px-6 pb-14 pt-4">
        <!-- Ambient glow behind carousel -->
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="h-[500px] w-[900px] rounded-full bg-blue-600/5 blur-[120px]"></div>
        </div>

        <div class="mx-auto max-w-6xl">
          <!-- Carousel wrapper -->
          <div id="carousel" class="relative" role="region" aria-label="Screenshot carousel">
            <!-- Slides -->
            <div class="relative h-auto overflow-hidden rounded-xl ring-1 ring-white/[0.08] shadow-2xl shadow-black/60">
              <!-- Slide: Timeline view -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="0"
                style="opacity:1;transform:translateX(0%) scale(0.97);z-index:0;"
              >
                <img
                  src={timelineImg.src}
                  alt="Weekly timeline showing day columns with tasks dragged between days across the full week"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Desktop overview -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="1"
                style="opacity:0;transform:translateX(8%) scale(1);z-index:10;"
              >
                <img
                  src={desktopImg.src}
                  alt="Desktop app overview showing the full task management interface"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Quick add full -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="2"
                style="opacity:0;transform:translateX(8%) scale(0.97);z-index:0;"
              >
                <img
                  src={quickAddFullImg.src}
                  alt="Quick-add panel for capturing tasks instantly without breaking focus"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Project view -->
              <div
