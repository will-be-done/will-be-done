---
import Layout from '../layouts/Layout.astro';
import DockerInstall from '../components/DockerInstall.astro';
import TopBar from '../components/TopBar.astro';
import PageBackdrop from '../components/PageBackdrop.astro';
import { serialiseJsonLd } from '../lib/jsonLd';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import punishmentImg from '../assets/punishment.png';
import badDayImg from '../assets/bad_day2.png';
import weekImg from '../assets/week2.png';
import phoneImg from '../assets/phone.png';
import timelineImg from '../assets/timeline.png';
import projectImg from '../assets/project2.png';
import quickAddImg from '../assets/quick-add.png';
import meImg from '../assets/me.png';
import desktopImg from '../assets/desktop.png';
import quickAddFullImg from '../assets/quick-add-full.png';

const faqs = [
  {
    id: 'open_source',
    q: 'Is Will Be Done open source?',
    a: 'Yes. The whole thing is licensed under AGPL-3.0 and developed in the open on GitHub: web app, desktop app, sync server and API.',
  },
  {
    id: 'offline',
    q: 'Does Will Be Done work completely offline?',
    a: 'Yes. Every device keeps a full local database, so you can read tasks, create them, complete them and move them around your week with no network at all. Changes sync once you are back online.',
  },
  {
    id: 'self_hosting',
    q: 'Can I self-host it?',
    a: 'Yes, with one Docker container. It stores data in SQLite on a volume you control, needs no external services, and serves the web app plus the API from the same port.',
  },
  {
    id: 'data_storage',
    q: 'Where is my data stored?',
    a: 'A copy lives locally on every device you use, and the synced copy lives on whichever server you choose: your own Docker container, which keeps SQLite under /var/lib/will-be-done, or the hosted cloud.',
  },
  {
    id: 'account_required',
    q: 'Do I need an account?',
    a: 'Not for the live demo. It runs entirely in your browser with no signup. You need an account only to sync across devices, either on the cloud or on your own server.',
  },
  {
    id: 'cloud_version',
    q: 'Is there a cloud version?',
    a: 'Yes. app.will-be-done.app is free to start. Use it if you want sync across devices without running a server yourself.',
  },
  {
    id: 'pricing_model',
    q: 'How will Will Be Done make money?',
    a: 'The hosted cloud version will make money through paid plans. Self-hosting will never have a paywall, and no feature in the self-hosted version will require payment to Will Be Done. The self-hosted version will have the same features as the cloud unless a cloud feature cannot reasonably run without hosted infrastructure. In those cases, I will provide a self-hosted alternative when possible. For example, a self-hosted AI assistant will let you use your own OpenRouter API key. I will also keep the self-hosted infrastructure as simple as I can. The standard setup will use SQLite and a directory for uploaded attachments. It will not require Redis, an external database service or S3.',
  },
  {
    id: 'server_offline',
    q: 'What happens if my self-hosted server goes offline?',
    a: 'The app keeps working. Reads and writes hit your local database, and the app sends pending changes the moment the server comes back.',
  },
  {
    id: 'offline_conflict_resolution',
    q: 'What happens if I edit the same task on two devices while offline?',
    a: 'Both devices keep working, and they merge their changes field by field once they reconnect, with the last write winning. Say your phone is offline on the train and you rename a task to "Draft Q2 budget", then ten minutes later you rename the same task to "Draft Q2 budget deck" on your desktop: once both sync, the title is the desktop one, because it was edited later. Ordering comes from a hybrid logical clock rather than who reconnects first, so a stale edit uploaded later does not overwrite a newer one.',
  },
  {
    id: 'field_level_conflicts',
    q: 'Does a conflict ever lose my other changes?',
    a: 'Only the specific field that both devices changed is resolved that way. Because the merge is per field rather than per task, edits to different fields survive together: if your phone renamed a task while your desktop moved it to Thursday, you end up with the new title and the new day. Deletes are the one-way case: a deleted task stays deleted rather than being resurrected by an edit from another device.',
  },
  {
    id: 'task_import',
    q: 'Can I import my tasks from Todoist or TickTick?',
    a: 'Yes. Todoist imports through an API token you paste into Will Be Done, and TickTick imports from its CSV export. Both bring your projects and tasks into the space you choose.',
  },
  {
    id: 'mobile_app',
    q: 'Is there a mobile app?',
    a: 'Mobile today is a mobile-ready PWA you install to your home screen. It is a real mobile UI, not a shrunken desktop layout. App store builds are on the roadmap, and they will package this same web app for iOS and Android rather than being a separate native rewrite.',
  },
  {
    id: 'team_sharing',
    q: 'Can I share projects or use it with a team?',
    a: 'No. Will Be Done is a single-user planner. Multi-user spaces and shared tasks or projects are not planned for now, so treat it as a personal tool rather than a team tracker.',
  },
  {
    id: 'time_of_day_scheduling',
    q: 'Can I schedule a task for a specific time of day?',
    a: 'No. You schedule tasks to days, not to times, because the app plans a week rather than fills a calendar. Time-of-day scheduling is not planned for now.',
  },
  {
    id: 'end_to_end_encryption',
    q: 'Is my data end-to-end encrypted?',
    a: 'Not today. The data sits locally on your devices and on the server you sync with, which can be your own machine. End-to-end encryption is on the roadmap but is not implemented yet.',
  },
];

// Attached to the page graph defined in Layout.astro. Google no longer shows
// FAQ rich results, but this keeps the answers machine-readable for other
// consumers.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://will-be-done.app/#faq',
  url: 'https://will-be-done.app/',
  name: 'Will Be Done: frequently asked questions',
  isPartOf: { '@id': 'https://will-be-done.app/#webpage' },
  about: { '@id': 'https://will-be-done.app/#app' },
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};

const everythingElse = [
  'Recurring tasks by day of week, month or year',
  'Project kanban boards with your own columns',
  'Separate spaces for work and personal',
  'Today view and weekly timeline',
  'Stash for what you are focused on right now',
  'Desktop apps for Linux, macOS and Windows',
  'Global quick add shortcut',
  'Mobile-ready PWA',
  'Drag and drop for tasks, days and projects',
  'HTTP API with OpenAPI docs',
  'Task descriptions and checklists',
  'Real-time sync across tabs and devices',
];
---

<Layout>
  <PageBackdrop>
    <main>
      <TopBar />

      <!-- Hero -->
      <section aria-label="Hero" class="relative px-6 pb-10 pt-28 md:pt-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="mb-6 inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 rounded-full bg-white/[0.03] px-3.5 py-1.5 text-[10px] font-medium uppercase tracking-[0.1em] text-blue-300/90 ring-1 ring-blue-400/[0.18] sm:px-4 sm:text-[11px] sm:tracking-[0.14em]">
            <span>Open source</span>
            <span class="text-blue-400/40">·</span>
            <span>Local-first</span>
            <span class="text-blue-400/40">·</span>
            <span>Self-hostable</span>
          </p>

          <h1 class="mb-6 font-bold tracking-tight text-4xl md:text-6xl leading-[1.05]">
            <span class="text-white">Plan your week,</span><br />
            <span class="bg-gradient-to-r from-blue-300 via-blue-400 to-indigo-400 bg-clip-text text-transparent">not just your tasks.</span>
          </h1>

          <p class="mx-auto mb-5 max-w-2xl text-[17px] leading-relaxed text-slate-400 md:text-[19px]">
            Will Be Done is a local-first task manager built around a visual weekly timeline. It works fully offline,
            syncs across devices, and can be self-hosted with one Docker command.
          </p>

          <p class="mb-9 text-[15px] font-medium text-slate-500">
            100 tasks. <span class="text-slate-300">What are you doing this week?</span>
          </p>

          <!-- Primary CTAs -->
          <div class="flex flex-wrap items-center justify-center gap-3">
            <a
              href="https://demo.will-be-done.app"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-blue-500 px-6 py-3.5 text-[15px] font-semibold text-white shadow-[0_2px_12px_rgba(59,130,246,0.3),inset_0_1px_0_rgba(255,255,255,0.15)] transition-all hover:bg-blue-400 hover:shadow-[0_4px_20px_rgba(59,130,246,0.45),inset_0_1px_0_rgba(255,255,255,0.15)]"
              data-ph-event="demo_clicked"
              data-ph-section="hero"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
              </svg>
              Try live demo
            </a>
            <a
              href="#self-host"
              class="group inline-flex items-center gap-2 rounded-xl bg-white/[0.05] px-6 py-3.5 text-[15px] font-medium text-slate-200 ring-1 ring-white/[0.10] transition-all hover:bg-white/[0.08] hover:text-white hover:ring-white/[0.18]"
              data-ph-event="selfhost_anchor_clicked"
              data-ph-section="hero"
            >
              Self-host
              <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>
            </a>
          </div>

          <!-- Tertiary links -->
          <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px]">
            <a
              href="https://github.com/will-be-done/will-be-done"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-slate-400 transition-colors hover:text-white"
              data-ph-event="github_link_clicked"
              data-ph-section="hero"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
              </svg>
              GitHub
            </a>
            <button
              data-open-modal
              class="inline-flex cursor-pointer items-center gap-1.5 text-slate-400 transition-colors hover:text-white"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z" />
              </svg>
              Watch the demo
            </button>
            <a
              href="https://github.com/will-be-done/will-be-done/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-1.5 text-slate-400 transition-colors hover:text-white"
              data-ph-event="download_clicked"
              data-ph-section="hero"
              data-ph-destination="github_releases"
            >
              <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download desktop app
            </a>
          </div>

          <!-- Reassurance + platforms -->
          <p class="mt-5 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 text-[11px] text-slate-600">
            <span>No signup required for the demo</span>
            <span class="text-slate-700">·</span>
            <!-- Apple -->
            <span class="flex items-center gap-1">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 640 640">
                <path d="M447.1 332.7C446.9 296 463.5 268.3 497.1 247.9C478.3 221 449.9 206.2 412.4 203.3C376.9 200.5 338.1 224 323.9 224C308.9 224 274.5 204.3 247.5 204.3C191.7 205.2 132.4 248.8 132.4 337.5C132.4 363.7 137.2 390.8 146.8 418.7C159.6 455.4 205.8 545.4 254 543.9C279.2 543.3 297 526 329.8 526C361.6 526 378.1 543.9 406.2 543.9C454.8 543.2 496.6 461.4 508.8 424.6C443.6 393.9 447.1 334.6 447.1 332.7zM390.5 168.5C417.8 136.1 415.3 106.6 414.5 96C390.4 97.4 362.5 112.4 346.6 130.9C329.1 150.7 318.8 175.2 321 202.8C347.1 204.8 370.9 191.4 390.5 168.5z"/>
              </svg>
              macOS
            </span>
            <span class="text-slate-700">·</span>
            <!-- Linux -->
            <span class="flex items-center gap-1">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 640 640">
                <path d="M316.9 187.3C317.9 187.8 318.7 189 319.9 189C321 189 322.7 188.6 322.8 187.5C323 186.1 320.9 185.2 319.6 184.6C317.9 183.9 315.7 183.6 314.1 184.5C313.7 184.7 313.3 185.2 313.5 185.6C313.8 186.9 315.8 186.7 316.9 187.3zM295 189C296.2 189 297 187.8 298 187.3C299.1 186.7 301.1 186.9 301.5 185.7C301.7 185.3 301.3 184.8 300.9 184.6C299.3 183.7 297.1 184 295.4 184.7C294.1 185.3 292 186.2 292.2 187.6C292.3 188.6 294 189.1 295 189zM516 467.8C512.4 463.8 510.7 456.2 508.8 448.1C507 440 504.9 431.3 498.3 425.7C497 424.6 495.7 423.6 494.3 422.8C493 422 491.6 421.3 490.2 420.8C499.4 393.5 495.8 366.3 486.5 341.7C475.1 311.6 455.2 285.3 440 267.3C422.9 245.8 406.3 225.4 406.6 195.3C407.1 149.4 411.7 64.1 330.8 64C228.4 63.8 254 167.4 252.9 199.2C251.2 222.6 246.5 241 230.4 263.9C211.5 286.4 184.9 322.7 172.3 360.6C166.3 378.5 163.5 396.7 166.1 413.9C159.6 419.7 154.7 428.6 149.5 434.1C145.3 438.4 139.2 440 132.5 442.4C125.8 444.8 118.5 448.4 114 456.9C111.9 460.8 111.2 465 111.2 469.3C111.2 473.2 111.8 477.2 112.4 481.1C113.6 489.2 114.9 496.8 113.2 501.9C108 516.3 107.3 526.3 111 533.6C114.8 540.9 122.4 544.1 131.1 545.9C148.4 549.5 171.9 548.6 190.4 558.4C210.2 568.8 230.3 572.5 246.3 568.8C257.9 566.2 267.4 559.2 272.2 548.6C284.7 548.5 298.5 543.2 320.5 542C335.4 540.8 354.1 547.3 375.6 546.1C376.2 548.4 377 550.7 378.1 552.8L378.1 552.9C386.4 569.6 401.9 577.2 418.4 575.9C435 574.6 452.5 564.9 466.7 548C480.3 531.6 502.7 524.8 517.6 515.8C525 511.3 531 505.7 531.5 497.5C531.9 489.3 527.1 480.2 516 467.8zM319.8 151.3C329.6 129.1 354 129.5 363.8 150.9C370.3 165.1 367.4 181.8 359.5 191.3C357.9 190.5 353.6 188.7 346.9 186.4C348 185.2 350 183.7 350.8 181.8C355.6 170 350.6 154.8 341.7 154.5C334.4 154 327.8 165.3 329.9 177.5C325.8 175.5 320.5 174 316.9 173.1C315.9 166.2 316.6 158.5 319.8 151.3zM279.1 139.8C289.2 139.8 299.9 154 298.2 173.3C294.7 174.3 291.1 175.8 288 177.9C289.2 169 284.7 157.8 278.4 158.3C270 159 268.6 179.5 276.6 186.4C277.6 187.2 278.5