      <!-- App UI right under the hero -->
      <section aria-label="App screenshots" class="relative overflow-hidden px-6 pb-14 pt-4">
        <!-- Ambient glow behind carousel -->
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <div class="h-[500px] w-[900px] rounded-full bg-blue-600/5 blur-[120px]"></div>
        </div>

        <div class="mx-auto max-w-6xl">
          <!-- Carousel wrapper -->
          <div id="carousel" class="relative" role="region" aria-label="Screenshot carousel">
            <!-- Slides -->
            <div class="relative h-auto overflow-hidden rounded-xl ring-1 ring-white/[0.08] shadow-2xl shadow-black/60">
              <!-- Slide: Timeline view -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="0"
                style="opacity:1;transform:translateX(0%) scale(0.97);z-index:0;"
              >
                <img
                  src={timelineImg.src}
                  alt="Weekly timeline — drag tasks between days across the full week view"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Desktop overview -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="1"
                style="opacity:0;transform:translateX(8%) scale(1);z-index:10;"
              >
                <img
                  src={desktopImg.src}
                  alt="Desktop app overview — full task management interface"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Quick add full -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="2"
                style="opacity:0;transform:translateX(8%) scale(0.97);z-index:0;"
              >
                <img
                  src={quickAddFullImg.src}
                  alt="Quick-add panel — capture tasks instantly without breaking focus"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Project view -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="3"
                style="opacity:0;transform:translateX(8%) scale(0.97);z-index:0;"
              >
                <img
                  src="/project.png"
                  alt="Project kanban board — organize tasks by status across Week, Month, Ideas, and Someday columns"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Slide: Today view -->
              <div
                class="carousel-slide absolute inset-0 transition-all duration-700 ease-[cubic-bezier(0.4,0,0.2,1)]"
                data-slide="4"
                style="opacity:0;transform:translateX(8%) scale(0.97);z-index:0;"
              >
                <img
                  src="/today.png"
                  alt="Today view — focused daily task list with quick-add and completion tracking"
                  class="w-full block"
                  loading="eager"
                />
              </div>

              <!-- Invisible spacer image to set container height (uses first slide) -->
              <img src={timelineImg.src} alt="" aria-hidden="true" class="w-full block invisible" />

              <!-- Gradient overlays for nav buttons -->
              <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-black/20 to-transparent rounded-l-xl"></div>
              <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-black/20 to-transparent rounded-r-xl"></div>

              <!-- Prev button -->
              <button
                id="carousel-prev"
                aria-label="Previous screenshot"
                class="carousel-btn absolute left-3 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.06] ring-1 ring-white/[0.12] backdrop-blur-sm transition-all duration-200 hover:bg-white/[0.12] hover:ring-white/[0.20] hover:scale-110 active:scale-95 cursor-pointer"
              >
                <svg class="h-4 w-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <!-- Next button -->
              <button
                id="carousel-next"
                aria-label="Next screenshot"
                class="carousel-btn absolute right-3 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/[0.06] ring-1 ring-white/[0.12] backdrop-blur-sm transition-all duration-200 hover:bg-white/[0.12] hover:ring-white/[0.20] hover:scale-110 active:scale-95 cursor-pointer"
              >
                <svg class="h-4 w-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>

            <!-- Bottom bar: caption + indicators -->
            <div class="mt-5 flex items-center justify-between gap-4">
              <!-- Caption -->
              <div class="relative h-5 flex-1 overflow-hidden">
                <p class="carousel-caption absolute inset-0 text-[13px] text-slate-400 transition-all duration-500" data-caption="0" style="opacity:1;transform:translateY(0)">
                  <span class="font-medium text-slate-200">Weekly timeline</span>: See the full week, drag tasks between any day
                </p>
                <p class="carousel-caption absolute inset-0 text-[13px] text-slate-400 transition-all duration-500" data-caption="1" style="opacity:0;transform:translateY(8px)">
                  <span class="font-medium text-slate-200">Desktop app</span>: Full task management experience
                </p>
                <p class="carousel-caption absolute inset-0 text-[13px] text-slate-400 transition-all duration-500" data-caption="2" style="opacity:0;transform:translateY(8px)">
                  <span class="font-medium text-slate-200">Quick add</span>: Capture tasks instantly without breaking focus
                </p>
                <p class="carousel-caption absolute inset-0 text-[13px] text-slate-400 transition-all duration-500" data-caption="3" style="opacity:0;transform:translateY(8px)">
                  <span class="font-medium text-slate-200">Project board</span>: Kanban view for your project areas
                </p>
                <p class="carousel-caption absolute inset-0 text-[13px] text-slate-400 transition-all duration-500" data-caption="4" style="opacity:0;transform:translateY(8px)">
                  <span class="font-medium text-slate-200">Today view</span>: Your focused daily task list with instant capture
                </p>
              </div>

              <!-- Dot indicators with progress -->
              <div class="flex shrink-0 items-center gap-2" role="tablist" aria-label="Screenshot navigation">
                {[0, 1, 2, 3, 4].map((i) => (
                  <button
                    class="carousel-dot relative h-1.5 overflow-hidden rounded-full bg-white/[0.12] transition-all duration-300"
                    data-dot={i}
                    role="tab"
                    aria-label={`Screenshot ${i + 1}`}
                    style={i === 0 ? "width:28px;" : "width:14px;"}
                  >
                    <span
                      class="carousel-dot-fill absolute inset-y-0 left-0 rounded-full bg-blue-400 transition-none"
                      style={i === 0 ? "width:100%;transition:width 0s;" : "width:0%;"}
                    ></span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

