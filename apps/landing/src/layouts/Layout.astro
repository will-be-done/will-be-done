---
import '../styles/global.css';
import PostHog from '../components/posthog.astro';
import Tawk from '../components/Tawk.astro';
import { serialiseJsonLd } from '../lib/jsonLd';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, e.g. "/releases/". Drives the canonical and og:url. */
  path?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Absolute or site-relative image used for og:image and twitter:image. */
  ogImage?: string;
  ogType?: string;
  /** Extra schema.org nodes merged into the site graph for this page. */
  schema?: Record<string, unknown>[];
}

const {
  title = 'Will Be Done: Plan Your Week | Open Source, Local-First Task Manager',
  description = 'Will Be Done is a local-first task manager built around a visual weekly timeline. It works fully offline, syncs across devices, and can be self-hosted with one Docker command. Open source, AGPL-3.0, keyboard-first with Vim navigation.',
  path = '/',
  ogTitle = 'Will Be Done: Plan your week, not just your tasks.',
  ogDescription = 'A local-first task manager built around a visual weekly timeline. Works fully offline, syncs across devices, self-hostable with one Docker command. Open source and AGPL-3.0.',
  ogImage = '/screen.png',
  ogType = 'website',
  schema = [],
} = Astro.props;

const siteUrl = 'https://will-be-done.app/';
const repoUrl = 'https://github.com/will-be-done/will-be-done';
const screenshotUrl = `${siteUrl}screen.png`;

const canonicalUrl = new URL(path, siteUrl).href;
const ogImageUrl = new URL(ogImage, siteUrl).href;

// One connected graph: everything hangs off stable @id values so the site,
// page, app and publisher describe the same entity.
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const webPageId = `${canonicalUrl}#webpage`;
const applicationId = `${siteUrl}#app`;
const personId = `${siteUrl}#sergey`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Sergey Popov',
      url: 'https://github.com/quolpr',
      description:
        'Solo developer of Will Be Done, with more than 10 years of development experience including 4 years on offline-first apps.',
      knowsAbout: ['Local-first software', 'Offline-first applications', 'TypeScript', 'Task management'],
      sameAs: ['https://github.com/quolpr'],
    },
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Will Be Done',
      url: siteUrl,
      description:
        'Maker of Will Be Done, an open source, local-first task manager built around weekly planning.',
      logo: {
        '@type': 'ImageObject',
        '@id': `${siteUrl}#logo`,
        url: `${siteUrl}ios/512.png`,
        width: 512,
        height: 512,
        caption: 'Will Be Done',
      },
      founder: { '@id': personId },
      sameAs: [repoUrl, 'https://github.com/will-be-done'],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'Will Be Done',
      url: siteUrl,
      description,
      inLanguage: 'en',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': webPageId,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': websiteId },
      about: { '@id': applicationId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        '@id': `${canonicalUrl}#primaryimage`,
        url: ogImageUrl,
        caption: 'Will Be Done weekly timeline',
      },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': applicationId,
      name: 'Will Be Done',
      url: siteUrl,
      description,
      // Google only recognises a fixed set of app categories, and
      // ProductivityApplication is not one of them.
      applicationCategory: 'BusinessApplication',
      applicationSubCategory: 'Task manager',
      operatingSystem: 'Web, Linux, macOS, Windows',
      softwareRequirements: 'Modern web browser, or Docker for self-hosting',
      installUrl: `${repoUrl}/releases`,
      downloadUrl: `${repoUrl}/releases`,
      isAccessibleForFree: true,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
      },
      featureList: [
        'Visual weekly timeline with a column per day',
        'Drag and drop tasks between days, projects and sections',
        'Local-first: full database on the device, works fully offline',
        'Sync across devices through your own server or the cloud',
        'Vim keybindings and keyboard-first navigation',
        'Global quick add shortcut on the desktop app',
        'Kanban board per project with custom sections',
        'Separate spaces for work and personal',
        'Recurring tasks by day of week, month or year',
        'Mobile-ready PWA and desktop apps for Linux, macOS and Windows',
        'HTTP API with OpenAPI documentation',
        'Todoist and TickTick import',
        'Self-hosted with one Docker container and SQLite storage',
      ],
      screenshot: {
        '@type': 'ImageObject',
        url: screenshotUrl,
        caption: 'Will Be Done weekly timeline',
      },
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      publisher: { '@id': organizationId },
      author: { '@id': personId },
      creator: { '@id': personId },
      sameAs: [repoUrl],
    },
    {
      // codeRepository belongs to SoftwareSourceCode, not SoftwareApplication.
      '@type': 'SoftwareSourceCode',
      '@id': `${siteUrl}#source`,
      name: 'Will Be Done source code',
      codeRepository: repoUrl,
      targetProduct: { '@id': applicationId },
      programmingLanguage: 'TypeScript',
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      author: { '@id': personId },
      sameAs: [repoUrl],
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ios/32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/ios/16.png" />
    <link rel="apple-touch-icon" href="/ios/180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Will Be Done releases" href="/releases/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Will Be Done" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <PostHog />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={serialiseJsonLd(structuredData)} />
  </head>
  <body>
    <slot />
    <Tawk />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
  }
</style>
